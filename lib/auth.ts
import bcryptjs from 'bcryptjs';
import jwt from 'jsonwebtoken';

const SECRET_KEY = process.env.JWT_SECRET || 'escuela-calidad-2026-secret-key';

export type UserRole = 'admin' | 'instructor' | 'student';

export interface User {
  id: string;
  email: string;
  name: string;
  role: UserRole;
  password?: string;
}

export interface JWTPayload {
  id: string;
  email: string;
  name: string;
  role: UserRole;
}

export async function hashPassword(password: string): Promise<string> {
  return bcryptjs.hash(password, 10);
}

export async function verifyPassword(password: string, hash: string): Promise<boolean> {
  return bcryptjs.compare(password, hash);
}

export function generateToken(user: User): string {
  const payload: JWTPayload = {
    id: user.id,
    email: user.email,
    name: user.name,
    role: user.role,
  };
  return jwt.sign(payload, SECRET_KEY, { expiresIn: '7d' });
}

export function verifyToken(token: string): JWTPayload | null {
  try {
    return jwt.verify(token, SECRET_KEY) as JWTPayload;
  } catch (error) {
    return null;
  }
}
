:root {
  --color-primary: #075D7D;
  --color-secondary: #39A835;
  --color-accent: #FFD417;
  --color-danger: #FF0000;
  --color-white: #FFFFFF;
  --color-light-gray: #F8FAFC;
  --color-medium-gray: #E2E8F0;
  --color-dark-gray: #52657A;
  --color-text: #10213A;
}

html {
  color-scheme: light;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: linear-gradient(135deg, #f5f7ff 0%, #eef7ef 100%);
  color: var(--color-text);
  line-height: 1.6;
}

button,
input,
select,
textarea {
  font: inherit;
}

img {
  max-width: 100%;
  display: block;
}

.container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px;
}

header {
  background: var(--color-primary);
  color: white;
  padding: 20px 0;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 700;
  font-size: 1.1rem;
}

.logo img {
  width: 42px;
  height: 42px;
  border-radius: 8px;
}

.nav-menu {
  display: flex;
  gap: 20px;
  list-style: none;
}

.nav-menu a {
  color: white;
  text-decoration: none;
  opacity: 0.9;
}

.user-menu {
  display: flex;
  align-items: center;
  gap: 16px;
}

.logout-btn {
  border: none;
  background: var(--color-accent);
  color: var(--color-text);
  padding: 10px 18px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
}

.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  padding: 32px 20px;
}

.login-card {
  background: white;
  max-width: 420px;
  width: 100%;
  padding: 32px 28px;
  border-radius: 18px;
  box-shadow: 0 25px 60px rgba(0,0,0,0.2);
}

.login-card h1 {
  margin-top: 12px;
  font-size: 2rem;
}

.subtitle {
  margin-bottom: 24px;
  color: var(--color-dark-gray);
}

.form-group {
  margin-bottom: 16px;
}

.form-group label {
  display: block;
  margin-bottom: 8px;
  font-weight: 700;
}

.form-group input,
.form-group textarea,
.form-group select {
  width: 100%;
  border: 1px solid var(--color-medium-gray);
  border-radius: 10px;
  padding: 12px 14px;
  font-size: 1rem;
  background: white;
}

.btn-primary,
.btn-secondary,
.btn-accent {
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 700;
  transition: transform 0.15s ease;
}

.btn-primary {
  width: 100%;
  background: var(--color-primary);
  color: white;
  padding: 14px 18px;
}

.btn-primary:hover,
.btn-secondary:hover,
.btn-accent:hover,
.logout-btn:hover {
  transform: translateY(-1px);
}

.btn-secondary {
  background: var(--color-light-gray);
  color: var(--color-text);
  padding: 12px 18px;
}

.btn-accent {
  background: var(--color-primary);
  color: white;
  padding: 10px 14px;
}

.error-message {
  background: #fee2e2;
  color: var(--color-danger);
  border-radius: 10px;
  padding: 12px 14px;
  margin-bottom: 18px;
  font-size: 0.9rem;
}

.success-message {
  background: #dcfce7;
  color: var(--color-secondary);
  border-radius: 10px;
  padding: 12px 14px;
  margin-bottom: 18px;
  font-size: 0.9rem;
}

.dashboard {
  padding: 40px 0 80px;
}

.dashboard-header {
  margin-bottom: 28px;
}

.dashboard-header h1 {
  font-size: 2.1rem;
  margin-bottom: 8px;
}

.dashboard-header p {
  color: var(--color-dark-gray);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 20px;
  margin-bottom: 36px;
}

.stat-card {
  background: white;
  padding: 24px;
  border-radius: 14px;
  box-shadow: 0 10px 20px rgba(15,23,42,0.04);
  border-left: 5px solid var(--color-primary);
}

.stat-card.success { border-left-color: var(--color-secondary); }
.stat-card.warning { border-left-color: var(--color-accent); }
.stat-card.danger { border-left-color: var(--color-danger); }

.stat-label {
  color: var(--color-dark-gray);
  font-size: 0.85rem;
  margin-bottom: 8px;
}

.stat-value {
  font-size: 2.4rem;
  font-weight: 700;
  color: var(--color-primary);
}

.modules-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
  margin-top: 18px;
}

.module-card {
  background: white;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 10px 24px rgba(15,23,42,0.05);
}

.module-header {
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  padding: 22px 20px;
  color: white;
}

.module-header h3 {
  margin: 0 0 8px;
  font-size: 1.3rem;
}

.module-meta {
  font-size: 0.8rem;
  opacity: 0.9;
}

.module-body {
  padding: 20px;
}

.module-status {
  display: inline-block;
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.status-active { background: #dcfce7; color: var(--color-secondary); }
.status-upcoming { background: #fef3c7; color: #b45309; }
.status-completed { background: #dbeafe; color: var(--color-primary); }

.module-description {
  color: var(--color-dark-gray);
  margin-bottom: 18px;
}

.module-footer {
  display: flex;
  gap: 10px;
}

.table-container {
  background: white;
  border-radius: 14px;
  box-shadow: 0 10px 20px rgba(15,23,42,0.04);
  overflow: hidden;
}

th, td {
  padding: 15px 16px;
  text-align: left;
  border-bottom: 1px solid var(--color-medium-gray);
}

table {
  width: 100%;
  border-collapse: collapse;
}

thead {
  background: var(--color-light-gray);
}

@media (max-width: 768px) {
  .header-content {
    flex-direction: column;
    align-items: flex-start;
  }

  .nav-menu {
    flex-wrap: wrap;
  }

  .module-footer {
    flex-direction: column;
  }
}
